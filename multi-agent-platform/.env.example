# Multi-Agent Platform configuration
# Copy to .env and fill in values from your Microsoft Foundry project.

# --- Microsoft Foundry (required) ---
AI_FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o

# --- Knowledge: persistent Foundry IQ / Azure AI Search (required) ---
AZURE_AI_SEARCH_ENDPOINT=https://<search>.search.windows.net
AZURE_SEARCH_KNOWLEDGE_BASE_NAME=<pre-provisioned-knowledge-base-name>
AZURE_SEARCH_KNOWLEDGE_API_VERSION=2025-11-01-Preview

# --- Sessions (optional; defaults to in-memory for local dev) ---
SESSION_BACKEND=memory
# REDIS_URL=redis://localhost:6379

# --- Runtime limits (optional) ---
RUNTIME_MAX_TURNS=6
RUNTIME_REQUEST_TIMEOUT_SECONDS=60

# --- Observability (optional) ---
# APPLICATIONINSIGHTS_CONNECTION_STRING=
