# Shared workshop configuration. Create .env at the repository root.
# Sign in using: az login --tenant <your-tenant-id>
# Values using ${NAME} are expanded by python-dotenv.

# Azure identity and resources
AZURE_TENANT_ID=<your-tenant-id>
TENANT_ID=${AZURE_TENANT_ID}
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>
AZURE_AI_ACCOUNT_NAME=<your-foundry-account>
AZURE_AI_PROJECT_NAME=<your-project-name>

# Configure the project once. Keep these SDK/deployment aliases derived.
AI_FOUNDRY_PROJECT_ENDPOINT=https://${AZURE_AI_ACCOUNT_NAME}.services.ai.azure.com/api/projects/${AZURE_AI_PROJECT_NAME}
FOUNDRY_PROJECT_ENDPOINT=${AI_FOUNDRY_PROJECT_ENDPOINT}
PROJECT_RESOURCE_ID=/subscriptions/${AZURE_SUBSCRIPTION_ID}/resourceGroups/${AZURE_RESOURCE_GROUP}/providers/Microsoft.CognitiveServices/accounts/${AZURE_AI_ACCOUNT_NAME}/projects/${AZURE_AI_PROJECT_NAME}
AZURE_AI_PROJECT_ID=${PROJECT_RESOURCE_ID}

# Model deployments and keyless Azure OpenAI access
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1
EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=${EMBEDDING_MODEL_DEPLOYMENT_NAME}
AZURE_OPENAI_ENDPOINT=https://${AZURE_AI_ACCOUNT_NAME}.openai.azure.com

# Keyless Azure AI Search and agentic retrieval
AZURE_AI_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
SEARCH_AUTHENTICATION_METHOD=azure-ad
AZURE_SEARCH_INDEX_NAME=<your-search-index>
AZURE_SEARCH_KNOWLEDGE_BASE_NAME=<your-knowledge-base>

# Foundry connections
GROUNDING_WITH_BING_CONNECTION_NAME=<your-bing-connection-name>
FOUNDRY_MCP_CONNECTION_ID=${PROJECT_RESOURCE_ID}/connections/<your-mcp-connection-name>

# Telemetry. Enable content capture only for deliberate synthetic-data tests.
AZURE_TRACING_GEN_AI_CONTENT_RECORDING_ENABLED=false
AZURE_SDK_TRACING_IMPLEMENTATION=opentelemetry
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# BYOM: set only after creating a gateway-connected model.
FOUNDRY_MODEL_DEPLOYMENT_NAME=
# BYOM_GATEWAY_BASE_URL=https://<your-apim>.azure-api.net/openai/v1
# BYOM_GATEWAY_API_KEY=
# BYOM_GATEWAY_KEY_HEADER=Ocp-Apim-Subscription-Key
# BYOM_GATEWAY_KEY_FORMAT={api_key}

# Optional API-key-only samples; leave unset when using Microsoft Entra authentication.
# AZURE_OPENAI_API_KEY=
# AZURE_AI_SEARCH_API_KEY=
